# Stage 1: build the store binary (cache key depends on full source).
FROM golang:1.24-bullseye AS store-builder
RUN apt-get update && apt-get install -y --no-install-recommends g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o /out/store ./cmd/store

# Stage 2: build the buildindex binary in isolation so edits to cmd/store don't
# invalidate this layer (which would force a 3-minute index rebuild on every
# iteration). Cache key is just hnsw/index/buildindex source + go.mod.
FROM golang:1.24-bullseye AS buildindex-builder
RUN apt-get update && apt-get install -y --no-install-recommends g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY internal/hnsw ./internal/hnsw
COPY internal/index ./internal/index
COPY cmd/buildindex ./cmd/buildindex
RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o /out/buildindex ./cmd/buildindex

# Stage 3: actually run buildindex once. Cache key is the buildindex binary
# (rarely changes) + references.json.gz. Output is ~150 MB of serialized index.
FROM debian:bullseye-slim AS index-builder
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --from=buildindex-builder /out/buildindex /usr/local/bin/buildindex
COPY resources/references.json.gz ./refs.json.gz
RUN mkdir -p /out && buildindex -refs ./refs.json.gz -out /out/index

# Stage 4: final runtime image — just the store binary + serialized index.
FROM debian:bullseye-slim
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=store-builder /out/store ./store
COPY --from=index-builder /out/index.graph ./resources/index.graph
COPY --from=index-builder /out/index.labels ./resources/index.labels
EXPOSE 9990
CMD ["./store"]
